# 默认 PHP 模式：浏览器请求同源 /api/*，由 Caddy 映射到本站 PHP 入口。
VITE_API_MODE=php
# 留空为同源；如确需跨域，只填写 HTTP(S) origin（无路径）。这不会启用加密协议。
VITE_API_BASE_URL=
# 仅有另行实现的 /api/v1/session、/api/v1/parse 服务时才设 VITE_API_MODE=secure。
# 本项目 PHP 后端不实现 secure 模式，部署构建保持 php。
# 本地 npm run dev 可设置 PHP 网关地址（仅影响开发代理，不写入浏览器构建）。
DEV_API_TARGET=http://127.0.0.1:8081
