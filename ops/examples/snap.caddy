# Review-only site fragment. Merge into the existing Caddy configuration.
# Never replace the fleet Caddyfile. Verify 9081 and socket paths before use.
snap.example.com {
    @api path /api/short_videos /api/douyin /api/ksjx /api/bilibili /api/xhsjx /api/toutiao
    @compress not path /api/media/weibo
    @source path *.php /backend/* /internal/* /ops/* /.git/* /.env*
    # Preserve ordering: Caddy otherwise sorts handle before route.
    route {
    # This file MUST exist. The supplied example fails closed until access is decided.
    import /etc/caddy/snap-access.caddy
    encode @compress zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy no-referrer

    # Exact signed-media endpoint: dedicated workers, no response buffering/compression.
    handle /api/media/weibo {
        root * /srv/dokitool/current/backend/public
        rewrite * /index.php
        php_fastcgi unix//run/php/snap-media.sock {
            resolve_root_symlink
            read_timeout 310s
            write_timeout 310s
            # Negative intervals disable upstream cancellation on client disconnect.
            flush_interval 100ms
        }
    }
    handle @api {
        root * /srv/dokitool/current/backend/public
        rewrite * /index.php
        php_fastcgi unix//run/php/snap-public.sock {
            resolve_root_symlink
        }
    }
    handle /api/* {
        header Content-Type application/json
        respond `{"code":404,"msg":"Unknown API route","data":[]}` 404
    }
    handle @source {
        respond 404
    }
    handle {
        root * /srv/dokitool/current/frontend/dist
        route {
            # HTML and non-versioned files revalidate; API/media routes above are unaffected.
            header Cache-Control "no-cache"
            @versioned {
                path_regexp hashed ^/assets/[A-Za-z0-9_.-]+-[A-Za-z0-9_-]{8}\.(js|css|png|webp|svg|ico|woff2|ttf)$
                file {path}
            }
            header @versioned Cache-Control "public, max-age=31536000, immutable"
            # A missing chunk must return 404, never long-cache the SPA HTML as JavaScript.
            handle /assets/* {
                file_server
            }
            handle {
                try_files {path} /index.html
                file_server
            }
        }
    }
    }
}

# Only the aggregator can call these routes over loopback. Different FPM pool:
# public requests must never consume all workers needed to answer a self-request.
http://:9081 {
    bind 127.0.0.1
    @parser {
        host snap.example.com
        path /parse/douyin /parse/kuaishou /parse/bilibili /parse/xiaohongshu /parse/toutiao /parse/weibo /parse/pipixia /parse/pipigx /parse/zuiyou
    }
    handle @parser {
        root * /srv/dokitool/current/backend/internal
        rewrite * /index.php
        php_fastcgi unix//run/php/snap-internal.sock {
            resolve_root_symlink
        }
    }
    handle {
        respond 404
    }
}
