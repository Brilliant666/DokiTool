# Review-only site fragment. Merge into the existing Caddy configuration.
# Never replace the fleet Caddyfile. Verify 9081 and socket paths before use.
snap.example.com {
    @api path /api/*
    @compress not path /api/media/weibo
    @source path *.php /backend/* /internal/* /ops/* /.git/* /.env*
    # Preserve ordering: Caddy otherwise sorts handle before route.
    route {
    # This file MUST exist. The supplied example fails closed until access is decided.
    import /etc/caddy/snap-access.caddy
    encode @compress zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy no-referrer
    # The download bridge is a same-origin iframe, not a public embedding surface.
    # Mutually exclusive setters avoid duplicate or conflicting framing headers.
    @download_bridge path /downloads/bridge.html
    @not_download_bridge not path /downloads/bridge.html
    header @download_bridge X-Frame-Options SAMEORIGIN
    header @not_download_bridge X-Frame-Options DENY
    # A 304 cannot replace Chromium's previously cached X-Frame-Options: DENY.
    # Return the small bridge document in full without touching Worker caching.
    request_header @download_bridge -If-None-Match
    request_header @download_bridge -If-Modified-Since

    # Exact signed-media endpoint: dedicated workers, no response buffering/compression.
    handle /api/media/weibo {
        root * /srv/dokitool/current/backend/public
        rewrite * /index.php
        php_fastcgi unix//run/php/snap-media.sock {
            resolve_root_symlink
            read_timeout 310s
            write_timeout 310s
            # Negative intervals disable upstream cancellation on client disconnect.
            flush_interval 100ms
        }
    }
    handle @api {
        root * /srv/dokitool/current/backend/public
        rewrite * /index.php
        php_fastcgi unix//run/php/snap-public.sock {
            resolve_root_symlink
        }
    }
    handle @source {
        respond 404
    }
    # Only the download Worker handles /downloads/file/* while active.
    # Missing scripts or expired handoff URLs must never become the SPA homepage.
    handle /downloads/* {
        root * /srv/dokitool/current/frontend/dist
        header @download_bridge Cache-Control "no-store"
        header @not_download_bridge Cache-Control "no-cache"
        file_server
    }
    # Exact SEO files must never fall through to the SPA, including when missing.
    handle /robots.txt {
        root * /srv/dokitool/current/frontend/dist
        header Content-Type "text/plain; charset=utf-8"
        header Cache-Control "no-cache"
        file_server
    }
    handle /sitemap.xml {
        root * /srv/dokitool/current/frontend/dist
        header Content-Type "application/xml; charset=utf-8"
        header Cache-Control "no-cache"
        file_server
    }
    handle /social/dokitool-share-v1.png {
        root * /srv/dokitool/current/frontend/dist
        header Content-Type "image/png"
        header Cache-Control "no-cache"
        file_server
    }
    handle {
        root * /srv/dokitool/current/frontend/dist
        route {
            # HTML and non-versioned files revalidate; API/media routes above are unaffected.
            header Cache-Control "no-cache"
            @versioned {
                path_regexp hashed ^/assets/[A-Za-z0-9_.-]+-[A-Za-z0-9_-]{8}\.(js|css|png|webp|svg|ico|woff2|ttf)$
                file {path}
            }
            header @versioned Cache-Control "public, max-age=31536000, immutable"
            # A missing chunk must return 404, never long-cache the SPA HTML as JavaScript.
            handle /assets/* {
                file_server
            }
            handle {
                try_files {path} /index.html
                file_server
            }
        }
    }
    }
}

# Only the aggregator can call these routes over loopback. Different FPM pool:
# public requests must never consume all workers needed to answer a self-request.
http://:9081 {
    bind 127.0.0.1
    @parser {
        host snap.example.com
        path /parse
    }
    handle @parser {
        root * /srv/dokitool/current/backend/internal
        rewrite * /index.php
        php_fastcgi unix//run/php/snap-internal.sock {
            resolve_root_symlink
        }
    }
    handle {
        respond 404
    }
}
